# name: test/sql/join/unique/test_unique_join.test
# description: Test UNIQUE JOIN bind-time uniqueness assertions
# group: [unique]

# ------------------------------------------------------------------------------
# Fixtures
# ------------------------------------------------------------------------------

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE uj_users (id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE uj_orders (order_id INTEGER, user_id INTEGER, qty INTEGER, PRIMARY KEY (order_id, user_id));

statement ok
CREATE TABLE uj_sessions (user_id INTEGER, ts TIMESTAMP);

statement ok
INSERT INTO uj_users VALUES (1, 'alice'), (2, 'bob');

statement ok
INSERT INTO uj_orders VALUES (1, 1, 30), (1, 2, 20), (2, 1, 10);

statement ok
INSERT INTO uj_sessions VALUES (1, '2024-01-01'), (1, '2024-01-02'), (2, '2024-01-01');

# ------------------------------------------------------------------------------
# Happy paths
# ------------------------------------------------------------------------------
# We only assert RHS uniqueness. These should all bind and run.

# Single-column PK on RHS
query I
SELECT COUNT(*)
FROM uj_sessions
UNIQUE JOIN uj_users
	ON uj_sessions.user_id = uj_users.id;
----
3

# Composite PK on RHS (all key columns in join predicate)
query I
SELECT COUNT(*)
FROM uj_sessions
UNIQUE INNER JOIN uj_orders
	ON uj_sessions.user_id = uj_orders.user_id AND uj_orders.order_id = 1;
----
3

# GROUP BY makes RHS unique on the grouping key
query I
SELECT COUNT(*) FROM uj_sessions UNIQUE INNER JOIN (
	SELECT user_id, MAX(ts) AS max_ts
	FROM uj_sessions
	GROUP BY user_id
) t ON uj_sessions.user_id = t.user_id;
----
3

# SELECT DISTINCT makes RHS unique on all output columns
query I
SELECT COUNT(*) FROM uj_sessions UNIQUE INNER JOIN (
	SELECT DISTINCT user_id
	FROM uj_sessions
) e ON uj_sessions.user_id = e.user_id;
----
3

# QUALIFY row_number() = 1 makes RHS unique over PARTITION BY keys
query I
SELECT COUNT(*) FROM uj_sessions UNIQUE INNER JOIN (
	SELECT user_id
	FROM uj_sessions
	QUALIFY row_number() OVER (PARTITION BY user_id ORDER BY ts) = 1
) s ON uj_sessions.user_id = s.user_id;
----
3

# View over PK table preserves uniqueness
# Also LEFT JOIN should not affect uniqueness
statement ok
CREATE VIEW uj_active_customers AS SELECT id FROM uj_users where name = 'bob';

query I
SELECT COUNT(*)
FROM uj_sessions UNIQUE LEFT JOIN uj_active_customers
	ON uj_sessions.user_id = uj_active_customers.id;
----
3


# ------------------------------------------------------------------------------
# Unhappy paths
# ------------------------------------------------------------------------------
# These should fail to bind or parse due to missing uniqueness guarantees.

# Composite PK but only one column in join predicate
statement error
SELECT * FROM uj_sessions UNIQUE INNER JOIN uj_orders ON uj_sessions.user_id = uj_orders.order_id;
----
UNIQUE JOIN failed

# No uniqueness constraint on RHS
statement error
SELECT * FROM uj_sessions UNIQUE INNER JOIN uj_sessions s2 ON uj_sessions.user_id = s2.user_id;
----
UNIQUE JOIN failed

# GROUP BY includes extra column not selected => output not unique
statement error
SELECT * FROM uj_sessions UNIQUE INNER JOIN (
	SELECT user_id FROM uj_sessions
	GROUP BY user_id, ts
) g ON uj_sessions.user_id = g.user_id;
----
UNIQUE JOIN failed

# RHS subquery with no uniqueness guarantee (nested)
statement error
SELECT * FROM uj_sessions UNIQUE INNER JOIN (
	SELECT user_id
	FROM (SELECT user_id, ts FROM uj_sessions) s
) t ON uj_sessions.user_id = t.user_id;
----
UNIQUE JOIN failed

# View with no uniqueness guarantee
statement ok
CREATE VIEW uj_sessions_view AS SELECT user_id, ts FROM uj_sessions;

statement error
SELECT * FROM uj_sessions UNIQUE INNER JOIN uj_sessions_view
ON uj_sessions.user_id = uj_sessions_view.user_id;
----
UNIQUE JOIN failed

# UNIQUE must not be allowed on ANTI joins
statement error
SELECT * FROM uj_sessions UNIQUE ANTI JOIN uj_users ON uj_sessions.user_id = uj_users.id;
----
Parser Error
