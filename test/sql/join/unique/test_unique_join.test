# name: test/sql/join/inner/test_unique_join.test
# description: Test UNIQUE JOIN bind-time uniqueness assertions
# group: [inner]

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE uj_customers (id INTEGER PRIMARY KEY, name VARCHAR, active BOOLEAN);

statement ok
CREATE TABLE uj_users (id INTEGER UNIQUE, email VARCHAR);

statement ok
CREATE TABLE uj_orders (o_id INTEGER, line INTEGER, customer_id INTEGER, user_id INTEGER, amount INTEGER);

statement ok
CREATE TABLE uj_order_items (order_id INTEGER, line INTEGER, qty INTEGER, PRIMARY KEY (order_id, line));

statement ok
CREATE TABLE uj_sessions (user_id INTEGER, ts TIMESTAMP);

statement ok
CREATE TABLE uj_events (user_id INTEGER, ts TIMESTAMP);

statement ok
INSERT INTO uj_customers VALUES (1, 'alice', true), (2, 'bob', true);

statement ok
INSERT INTO uj_users VALUES (101, 'a@example.com'), (102, 'b@example.com');

statement ok
INSERT INTO uj_orders VALUES
	(10, 1, 1, 101, 5),
	(10, 2, 1, 101, 7),
	(11, 1, 2, 102, 9),
	(12, 1, NULL, NULL, 1);

statement ok
INSERT INTO uj_order_items VALUES (10, 1, 1), (10, 2, 1), (11, 1, 2), (12, 1, 1);

statement ok
INSERT INTO uj_sessions VALUES (101, '2024-01-01'), (101, '2024-01-02'), (102, '2024-01-01');

statement ok
INSERT INTO uj_events VALUES (101, '2024-01-01'), (101, '2024-01-05'), (102, '2024-01-03');

query I
SELECT COUNT(*) FROM uj_orders UNIQUE JOIN uj_customers ON uj_orders.customer_id = uj_customers.id;
----
3

query I
SELECT COUNT(*) FROM uj_orders UNIQUE LEFT JOIN uj_users ON uj_orders.user_id = uj_users.id;
----
4

query I
SELECT COUNT(*) FROM uj_orders UNIQUE INNER JOIN uj_order_items
ON uj_orders.o_id = uj_order_items.order_id AND uj_orders.line = uj_order_items.line;
----
4

statement error
SELECT * FROM uj_orders UNIQUE INNER JOIN uj_order_items ON uj_orders.o_id = uj_order_items.order_id;
----
UNIQUE JOIN failed

statement error
SELECT * FROM uj_orders UNIQUE INNER JOIN uj_sessions ON uj_orders.user_id = uj_sessions.user_id;
----
UNIQUE JOIN failed

query I
SELECT COUNT(*) FROM uj_orders UNIQUE INNER JOIN (
	SELECT customer_id, SUM(amount) AS total
	FROM uj_orders
	GROUP BY customer_id
) t ON uj_orders.customer_id = t.customer_id;
----
3

query I
SELECT COUNT(*) FROM uj_orders UNIQUE INNER JOIN (
	SELECT DISTINCT user_id
	FROM uj_events
) e ON uj_orders.user_id = e.user_id;
----
3

statement error
SELECT * FROM uj_orders UNIQUE INNER JOIN (
	SELECT user_id, ts FROM uj_sessions
) s ON uj_orders.user_id = s.user_id;
----
UNIQUE JOIN failed

query I
WITH a AS (SELECT id, name FROM uj_customers),
     b AS (SELECT id, UPPER(name) AS name FROM a)
SELECT COUNT(*) FROM uj_orders UNIQUE INNER JOIN b ON uj_orders.customer_id = b.id;
----
3
